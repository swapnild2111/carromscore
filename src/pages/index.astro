---
import BaseLayout from '../layouts/BaseLayout.astro';
import MatchSetup from '../components/MatchSetup.svelte';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Carromscore — new match">
  <main class="wrap">
    <header class="hero">
      <img class="logo" src={`${base}icon-512.png`} alt="Carromscore logo" width="88" height="88" />
      <div class="titles">
        <h1>Carrom<span class="h1-accent">S</span>core</h1>
        <p class="tag">Live scoring for players &amp; broadcasters</p>
      </div>
      <!-- Lobby pill sits top-right so it doesn't get lost in the
           footer. Prominent enough to catch first-time visitors'
           eye; not so loud that it competes with the Start-match
           button. Labelled "Lobby" (not "Live") because the /live/
           destination now hosts Now Playing + History + Reports —
           calling it "Live" alone undersells the content. The red
           dot stays; it still signals ongoing broadcasts inside. -->
      <a class="live-cta" href={`${base}live/`} aria-label="Open the lobby">
        <span class="live-dot" aria-hidden="true"></span>
        <span class="live-lbl">Lobby</span>
      </a>
    </header>
    <MatchSetup client:only="svelte" />
    <!--
      Fallback surfaced ONLY when the Svelte island fails to hydrate
      or the JS bundle never arrives after a reasonable window. The
      main failure mode we've seen (2026-08-13, mobile): fresh install
      hits a bad-network moment, `_astro/MatchSetup.*.js` fetch fails,
      the astro-island stays empty, and the page reads as "half a
      title and nothing below." Two safeguards fire together:

      1. `astro:hydration-error` — dispatched by astro-island when
         the dynamic import throws (see astro-island's start()
         handler at build/astro-island.ts). We reveal the fallback
         chip on that event so the user gets a "Loading interrupted
         — Reload" affordance instead of a blank canvas.
      2. Watchdog timer — 8 seconds after DOMContentLoaded, if
         MatchSetup's rendered form isn't present in the DOM, we
         assume silent failure (no hydration-error fired) and reveal
         the fallback the same way. Belt-and-braces for edge cases
         where the module never loads at all (e.g. some corporate
         proxies drop module-type MIME).

      One-tap reload uses a cache-bypass query param so a genuinely
      broken cache entry gets refreshed on the retry. No auto-reload
      loop — the user always drives it.
    -->
    <div id="hydration-fallback" class="hydration-fallback" hidden>
      <div class="hf-body">
        <span class="hf-icon" aria-hidden="true">⚠</span>
        <div class="hf-text">
          <strong id="hf-title">Loading interrupted</strong>
          <span class="hf-sub" id="hf-sub">The setup screen didn't load. Tap Reload to try again.</span>
        </div>
      </div>
      <button type="button" class="hf-btn" id="hydration-fallback-reload">Reload</button>
    </div>
  </main>
  <script>
    (() => {
      const FALLBACK_ID = 'hydration-fallback';
      const RELOAD_BTN_ID = 'hydration-fallback-reload';
      const WATCHDOG_MS = 8000;
      // The Svelte form root — presence of `.setup` inside the
      // astro-island's rendered subtree is our "hydrated" signal.
      const HYDRATED_SELECTOR = 'astro-island form.setup';
      let revealed = false;
      const reveal = () => {
        if (revealed) return;
        revealed = true;
        const el = document.getElementById(FALLBACK_ID);
        if (!el) return;
        // Tailor the message to whether we're actually offline. On
        // Android WebViews / Chrome, `navigator.onLine` is generally
        // reliable — it flips false when the OS says no network.
        // First-install-offline is our headline bug: an APK opened
        // for the first time without connectivity has nothing cached
        // yet, so the JS bundle 404s inside the SW fallback.
        const offline = typeof navigator !== 'undefined' && navigator.onLine === false;
        const title = document.getElementById('hf-title');
        const sub = document.getElementById('hf-sub');
        if (offline) {
          if (title) title.textContent = "You're offline";
          if (sub) sub.textContent = 'Connect to the internet to load Carromscore the first time. After that, it works offline.';
        }
        el.hidden = false;
      };
      // 1. Explicit hydration error from astro-island.
      window.addEventListener('astro:hydration-error', reveal);
      // 2. Watchdog: 8s in, if the form still isn't there, show the
      // fallback. Runs regardless of the event above so we're
      // robust to `handleHydrationError` not firing at all.
      const startWatchdog = () => {
        window.setTimeout(() => {
          if (document.querySelector(HYDRATED_SELECTOR)) return;
          reveal();
        }, WATCHDOG_MS);
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startWatchdog, { once: true });
      } else {
        startWatchdog();
      }
      // Reload button — bypass the SW cache for the retry so a
      // corrupted cache entry doesn't stick. Adding a param forces
      // the SW's `cacheFirst` to miss and go network.
      document.addEventListener('click', (ev) => {
        const target = ev.target;
        if (!(target instanceof Element)) return;
        if (target.id !== RELOAD_BTN_ID) return;
        const url = new URL(window.location.href);
        url.searchParams.set('__retry', String(Date.now()));
        window.location.replace(url.toString());
      });
      // If the fallback is showing because we were offline and the
      // network comes back, reload automatically — the JS bundle
      // will now fetch successfully and the app hydrates. This
      // fixes the "user opened the APK on the train, waited a
      // couple minutes for wifi to come back" case.
      window.addEventListener('online', () => {
        if (revealed) {
          const url = new URL(window.location.href);
          url.searchParams.set('__retry', String(Date.now()));
          window.location.replace(url.toString());
        }
      });
    })();
  </script>
  <style>
    /* Fallback chip when the Svelte island fails to hydrate.
       Hidden by default; revealed by the inline script when
       either astro:hydration-error fires or the watchdog trips.
       Uses the app's amber-warning palette rather than a red-error
       one because a network hiccup is not a fatal state — one tap
       almost always fixes it. */
    .hydration-fallback {
      max-width: 640px;
      margin: 2rem auto;
      padding: 1rem 1.25rem;
      background: rgba(255, 213, 74, 0.06);
      border: 1px solid rgba(255, 213, 74, 0.35);
      border-radius: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      color: var(--fg, #f5f5f5);
    }
    .hf-body {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      min-width: 0;
    }
    .hf-icon {
      color: #ffb300;
      font-size: 1.4rem;
      line-height: 1;
      flex-shrink: 0;
    }
    .hf-text {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    .hf-text strong { font-size: 0.95rem; }
    .hf-sub {
      color: var(--muted, #9aa0a6);
      font-size: 0.8rem;
    }
    .hf-btn {
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      background: var(--accent, #ffd54a);
      color: #1a1a1a;
      border: none;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      flex-shrink: 0;
    }
    .hf-btn:hover { filter: brightness(1.08); }
    .hf-btn:active { transform: scale(0.97); }
    @media (max-width: 480px) {
      .hydration-fallback {
        flex-direction: column;
        align-items: stretch;
        gap: 0.6rem;
      }
      .hf-btn { align-self: flex-end; }
    }
    .wrap { padding: 1rem 0 0; }
    .hero {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem 1.25rem 0.5rem;
      max-width: 640px;
      margin: 0 auto;
    }
    .logo {
      width: 88px;
      height: 88px;
      border-radius: 20px;
      flex-shrink: 0;
      box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    }
    .titles { min-width: 0; }

    /* Live pill — pulsing red dot + label. Sits top-right of the hero.
       Gets a subtle rise on hover / active so it feels tappable. */
    .live-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.45rem 0.75rem;
      background: rgba(239, 83, 80, 0.1);
      border: 1px solid rgba(239, 83, 80, 0.5);
      border-radius: 999px;
      color: #ef5350;
      font-weight: 700;
      font-size: 0.82rem;
      letter-spacing: 0.04em;
      text-decoration: none;
      transition: background 0.15s, border-color 0.15s, transform 0.1s;
      flex-shrink: 0;
      align-self: center;
    }
    .live-cta:hover {
      background: rgba(239, 83, 80, 0.18);
      border-color: rgba(239, 83, 80, 0.8);
    }
    .live-cta:active { transform: scale(0.97); }
    .live-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: #ef5350;
      box-shadow: 0 0 8px rgba(239, 83, 80, 0.9);
      animation: livePulse 1.6s ease-in-out infinite;
    }
    @keyframes livePulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    /*
     * Title is the visual anchor of the setup screen. Gold gradient clipped
     * to the text, gentle drop-shadow, and a small underline accent so it
     * reads as a product mark, not just a header.
     */
    h1 {
      position: relative;
      display: inline-block;
      /* On narrow phones (< 360px) the previous 1.75rem floor was
         still too big to fit alongside the logo, so "CarromScore"
         wrapped mid-word ("CarromS / core"). Tighter floor + smaller
         min ensures single-line rendering on 320-360px devices. */
      font-size: clamp(1.35rem, 6.5vw, 2.4rem);
      letter-spacing: -0.01em;
      margin: 0;
      line-height: 1.05;
      font-weight: 900;
      word-break: keep-all;
      white-space: nowrap;
      background: linear-gradient(120deg, #ffd54a 0%, #ffb300 45%, #ff8f00 100%);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 6px rgba(255, 179, 0, 0.35));
    }
    h1::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -0.3rem;
      height: 3px;
      background: linear-gradient(90deg, transparent 0%, #ffd54a 30%, #ffb300 70%, transparent 100%);
      border-radius: 3px;
    }
    /*
     * The `S` in the middle carries a subtle emphasis — slightly larger and
     * given its own gradient clip. Nested spans inside a background-clip: text
     * parent paint to nothing unless they re-declare their own clipped fill,
     * which is why we repeat the gradient here.
     */
    .h1-accent {
      font-size: 1.08em;
      display: inline-block;
      transform: translateY(-0.02em);
      background: linear-gradient(120deg, #ffd54a 0%, #ffb300 45%, #ff8f00 100%);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
    .tag {
      color: var(--muted);
      margin: 0.25rem 0 0;
      font-size: 0.9rem;
    }
    @media (max-width: 380px) {
      .hero { gap: 0.6rem; padding: 1rem 1rem 0.25rem; }
      .logo { width: 64px; height: 64px; border-radius: 14px; }
      .live-cta {
        padding: 0.35rem 0.55rem;
        font-size: 0.72rem;
      }
    }
  </style>
</BaseLayout>

---
interface Props {
  title?: string;
}
const { title = 'Carromscore' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <title>{title}</title>
    <!--
      Page-scoped head slot. Used by score.astro to <link rel="preload">
      the DSEG7 woff2 so the digit font renders in the correct face on
      first paint — no FOUC swap from Courier New. See score.astro.
    -->
    <slot name="head" />
    <!--
      Removed the earlier BaseLayout-level dseg7 preload attempt (it
      would preload the woff for every page, including home/admin,
      which don't render seven-segment digits and pay the ~15KB cost
      for nothing).
    -->
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #0b0b0b;
        --fg: #f5f5f5;
        --muted: #9aa0a6;
        --accent: #ffd54a;
        --danger: #ef5350;
        --side-a: #4fc3f7;
        --side-b: #ff8a65;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        min-height: 100vh;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        overscroll-behavior: none;
      }
      body { min-height: 100dvh; }
      button {
        font: inherit;
        cursor: pointer;
        touch-action: manipulation;
      }
      /*
       * Offline banner. Fixed to the top of the viewport across every
       * route (mounted in BaseLayout, above the <slot>). Hidden by
       * default via the `hidden` attribute; the inline script below
       * flips its visibility on window online/offline events. Amber
       * palette matches the app's warning register without stealing
       * focus.
       */
      .offline-banner {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.4rem 0.75rem;
        background: rgba(255, 179, 0, 0.15);
        color: var(--accent);
        border-bottom: 1px solid rgba(255, 213, 74, 0.4);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        line-height: 1.3;
        text-align: center;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
      }
      .offline-banner[hidden] { display: none; }
      .offline-banner .offline-icon {
        font-size: 0.9rem;
        line-height: 1;
      }
      /* Push page content down when the banner is visible so it
         doesn't overlap the hero / lobby header. Uses a body-level
         data attribute the inline script sets. Also expose the
         banner height as a CSS variable so full-viewport-height
         children (like ScoreBoard's `.wrap` at 100dvh) can subtract
         it from their own dimension and stay fully within the
         visible area. Without this the score-board's 100dvh
         container overflows below the fold when the banner is up
         (reported 2026-08-15: /beta/score/ appeared blank on a
         short-viewport desktop window while offline). */
      body[data-offline="true"] {
        padding-top: 2.2rem;
        --offline-banner-h: 2.2rem;
      }
      body:not([data-offline]) {
        --offline-banner-h: 0px;
      }
      @media (max-width: 480px) {
        .offline-banner {
          font-size: 0.72rem;
          padding: 0.35rem 0.6rem;
        }
        body[data-offline="true"] {
          padding-top: 2rem;
          --offline-banner-h: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <div
      id="offline-banner"
      class="offline-banner"
      role="status"
      aria-live="polite"
      hidden
    >
      <span class="offline-icon" aria-hidden="true">⚠</span>
      <span class="offline-text">You're offline — matches save on this device and sync when you're back online.</span>
    </div>
    <slot />
    <script>
      /*
       * Service worker registration + update detection.
       *
       * The SW uses skipWaiting() + clients.claim(), so any new version
       * takes over as soon as it's fetched. When that happens while the
       * user is already on the page, we dispatch a `carrom:sw-updated`
       * event so the UI can show a small "New version installed —
       * restart" hint.
       *
       * The initial controller acquisition on first load is filtered
       * out: only *changes* to an existing controller count as updates.
       *
       * Skipped in dev mode only — the SW would serve stale bundles
       * between edits.
       */
      /*
       * Offline banner visibility. Purely browser-signal driven —
       * navigator.onLine + online/offline window events. This is a
       * lightweight visual hint; the ACTUAL "should we queue this
       * write?" decision lives in src/lib/connectivity.ts and also
       * consults Firebase's /.info/connected. Banner and connectivity
       * store are allowed to disagree briefly (e.g. WiFi with captive
       * portal: navigator says online, Firebase can't reach) — the
       * banner will be hidden but writes still get queued correctly.
       */
      (() => {
        const banner = document.getElementById('offline-banner');
        if (!banner) return;
        const apply = (online) => {
          banner.hidden = online;
          if (online) delete document.body.dataset.offline;
          else document.body.dataset.offline = 'true';
        };
        //
        // Cold-start reveal policy — avoid the "flash on, then hide"
        // that plagued earlier versions when Firebase's .info/connected
        // took ~1 second to confirm reachability on a good network.
        // Two branches:
        //
        // 1) navigator.onLine === false at boot. That's a definite
        //    "network is down" signal (Wi-Fi off, airplane mode,
        //    kernel-level "no network"), and we should reveal the
        //    banner immediately — waiting to consult Firebase would
        //    delay the honest signal for no benefit.
        //
        // 2) navigator.onLine === true at boot. Ambiguous: could be
        //    truly online (probably), captive portal, DNS-down, or
        //    DevTools throttled to Offline (navigator lies). Don't
        //    reveal the banner yet — wait for the connectivity module
        //    to make its call, and reveal only if it explicitly
        //    reports offline. Cost: on a slow-Firebase connection the
        //    banner takes ~2.5s (FIRST_CONNECT_TIMEOUT in
        //    connectivity.ts) to appear when actually offline via a
        //    captive portal. Acceptable trade — the false-positive
        //    banner flash was more disruptive than a slightly delayed
        //    true-positive.
        //
        // Also fires flushQueue() from ../lib/sync-queue on every
        // offline→online transition. Living here (not in any single
        // Svelte island) means the queue drains regardless of which
        // route the user is on, and even after they leave the score
        // screen.
        //
        const navSaysOffline = navigator.onLine === false;
        if (navSaysOffline) apply(false);
        // Track whether we've EVER heard from the connectivity module.
        // Before we have, `prevOnline` reflects the navigator-only
        // guess so the first "→ online" transition (if any) doesn't
        // trigger a spurious flush.
        let prevOnline = !navSaysOffline;
        Promise.all([
          import('../lib/connectivity'),
          import('../lib/sync-queue'),
          import('../lib/live-sync'),
        ]).then(([conn, queue, live]) => {
          conn.subscribeConnectivity((state) => {
            apply(state.online);
            if (!prevOnline && state.online) {
              // Offline → online: flush any queued writes now.
              // Fire-and-forget; flushQueue is idempotent and
              // handles its own errors.
              void queue.flushQueue();
            }
            prevOnline = state.online;
          });
          // Xiaomi / MIUI background-suspend workaround (v3.4.1):
          // when the app returns to foreground after being hidden
          // long enough that the OS could have suspended the RTDB
          // WebSocket, force-cycle the Firebase connection so the
          // offline banner clears and the socket re-establishes
          // immediately. The score screen has its own copy of this
          // handler, but home + lobby didn't — reported 2026-08-20
          // that the banner stuck on Xiaomi until the user minimised
          // and reopened the app. Hoisting it to BaseLayout means
          // every route benefits.
          // Reconnect nudge: force-cycle the Firebase WebSocket whenever
          // the app returns to focus. Android Chrome / TWA kills the
          // background socket aggressively; the SDK can take several
          // seconds to notice. Nudging immediately on resume clears the
          // "I have WiFi but app shows offline" symptom. We no longer
          // gate on a minimum hidden duration — the cycle is cheap and
          // the false-positive cost (nudging after a 1-second background)
          // is negligible. Two paths cover all Android resume scenarios:
          //   1. visibilitychange → visible (standard Chrome tab / TWA).
          //   2. window focus (some Android WebView / Chrome versions fire
          //      focus but not visibilitychange on app-switch-back).
          // Both paths trust navigator.onLine to immediately clear the
          // banner; Firebase will re-confirm within ~1s and re-show the
          // banner if we were actually offline.
          const nudgeOnResume = () => {
            if (navigator.onLine !== false) apply(true);
            void live.nudgeFirebaseReconnect();
          };
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') nudgeOnResume();
          });
          window.addEventListener('focus', nudgeOnResume);
        }).catch(() => {
          // Modules failed to load (e.g. offline first-visit and
          // SW cache is empty). Fall back to raw navigator.onLine.
          const applyNavigator = () => apply(navigator.onLine !== false);
          applyNavigator();
          window.addEventListener('online', applyNavigator);
          window.addEventListener('offline', applyNavigator);
        });
      })();

      if ('serviceWorker' in navigator) {
        if (import.meta.env.DEV) {
          navigator.serviceWorker.getRegistrations().then((regs) => {
            regs.forEach((r) => r.unregister());
          });
        } else {
          window.addEventListener('load', () => {
            navigator.serviceWorker
              .register(`${import.meta.env.BASE_URL}sw.js`, { scope: import.meta.env.BASE_URL })
              .then((reg) => {
                // Force a proactive update check on every page load.
                // Chrome auto-checks only every ~24h; explicit update()
                // makes new SW versions install right away, so the
                // corresponding cache (which is versioned by
                // APP_VERSION + manifest.buildId) rotates promptly.
                // Without this, HTML changes since the last-installed
                // SW's install() would sit in stale cache indefinitely,
                // manifesting as "banner is missing on hard-refresh
                // while offline" bugs.
                reg?.update().catch(() => {});
              })
              .catch(() => {});

            const hadControllerAtLoad = !!navigator.serviceWorker.controller;
            navigator.serviceWorker.addEventListener('controllerchange', () => {
              if (!hadControllerAtLoad) return;
              window.dispatchEvent(new CustomEvent('carrom:sw-updated'));
            });
          });
        }
      }
    </script>
  </body>
</html>

---
interface Props {
  title?: string;
}
const { title = 'Carromscore' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #0b0b0b;
        --fg: #f5f5f5;
        --muted: #9aa0a6;
        --accent: #ffd54a;
        --danger: #ef5350;
        --side-a: #4fc3f7;
        --side-b: #ff8a65;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        min-height: 100vh;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        overscroll-behavior: none;
      }
      body { min-height: 100dvh; }
      button {
        font: inherit;
        cursor: pointer;
        touch-action: manipulation;
      }

      /* Beta channel banner — only visible when the deploy landed
         under /carromscore/beta/. Small strip pinned to the top of
         the viewport so testers can never forget which build they're
         on. `data-channel="beta"` is set inline before hydration by
         the script in <body>. */
      html[data-channel="beta"] body {
        padding-top: 1.75rem;
      }
      html[data-channel="beta"] body::before {
        content: "BETA · v2.0 preview · not for production";
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 200;
        padding: 0.35rem 0.75rem;
        background: linear-gradient(90deg, #7a1c1c, #a02525);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }
    </style>
  </head>
  <body>
    <script is:inline define:vars={{ base }}>
      // Set data-channel="beta" on <html> so the tiny beta banner
      // and any future channel-specific tweaks can key off it.
      if (base.includes('/beta/')) {
        document.documentElement.dataset.channel = 'beta';
      }
    </script>
    <slot />
    <script>
      /*
       * Service worker registration + update detection.
       *
       * The SW uses skipWaiting() + clients.claim(), so any new version
       * takes over as soon as it's fetched. When that happens while the
       * user is already on the page, we dispatch a `carrom:sw-updated`
       * event so the UI can show a small "New version installed —
       * restart" hint.
       *
       * The initial controller acquisition on first load is filtered
       * out: only *changes* to an existing controller count as updates.
       *
       * SKIP in two situations:
       *   - Dev mode: SW would serve stale bundles between edits.
       *   - Beta channel (/carromscore/beta/): beta builds change
       *     frequently; also public/sw.js hardcodes /carromscore/
       *     paths and wouldn't work under /beta/ anyway.
       */
      if ('serviceWorker' in navigator) {
        const isBeta = import.meta.env.BASE_URL.includes('/beta/');
        if (import.meta.env.DEV || isBeta) {
          navigator.serviceWorker.getRegistrations().then((regs) => {
            regs.forEach((r) => r.unregister());
          });
        } else {
          window.addEventListener('load', () => {
            navigator.serviceWorker
              .register(`${import.meta.env.BASE_URL}sw.js`, { scope: import.meta.env.BASE_URL })
              .catch(() => {});

            const hadControllerAtLoad = !!navigator.serviceWorker.controller;
            navigator.serviceWorker.addEventListener('controllerchange', () => {
              if (!hadControllerAtLoad) return;
              window.dispatchEvent(new CustomEvent('carrom:sw-updated'));
            });
          });
        }
      }
    </script>
  </body>
</html>

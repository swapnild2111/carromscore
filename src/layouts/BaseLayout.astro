---
interface Props {
  title?: string;
}
const { title = 'Carromscore' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #0b0b0b;
        --fg: #f5f5f5;
        --muted: #9aa0a6;
        --accent: #ffd54a;
        --danger: #ef5350;
        --side-a: #4fc3f7;
        --side-b: #ff8a65;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        min-height: 100vh;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        overscroll-behavior: none;
      }
      body { min-height: 100dvh; }
      button {
        font: inherit;
        cursor: pointer;
        touch-action: manipulation;
      }
      /*
       * Offline banner. Fixed to the top of the viewport across every
       * route (mounted in BaseLayout, above the <slot>). Hidden by
       * default via the `hidden` attribute; the inline script below
       * flips its visibility on window online/offline events. Amber
       * palette matches the app's warning register without stealing
       * focus.
       */
      .offline-banner {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.4rem 0.75rem;
        background: rgba(255, 179, 0, 0.15);
        color: var(--accent);
        border-bottom: 1px solid rgba(255, 213, 74, 0.4);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        line-height: 1.3;
        text-align: center;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
      }
      .offline-banner[hidden] { display: none; }
      .offline-banner .offline-icon {
        font-size: 0.9rem;
        line-height: 1;
      }
      /* Push page content down when the banner is visible so it
         doesn't overlap the hero / lobby header. Uses a body-level
         data attribute the inline script sets. */
      body[data-offline="true"] { padding-top: 2.2rem; }
      @media (max-width: 480px) {
        .offline-banner {
          font-size: 0.72rem;
          padding: 0.35rem 0.6rem;
        }
        body[data-offline="true"] { padding-top: 2rem; }
      }
    </style>
  </head>
  <body>
    <div
      id="offline-banner"
      class="offline-banner"
      role="status"
      aria-live="polite"
      hidden
    >
      <span class="offline-icon" aria-hidden="true">⚠</span>
      <span class="offline-text">You're offline — matches save on this device and sync when you're back online.</span>
    </div>
    <slot />
    <script>
      /*
       * Service worker registration + update detection.
       *
       * The SW uses skipWaiting() + clients.claim(), so any new version
       * takes over as soon as it's fetched. When that happens while the
       * user is already on the page, we dispatch a `carrom:sw-updated`
       * event so the UI can show a small "New version installed —
       * restart" hint.
       *
       * The initial controller acquisition on first load is filtered
       * out: only *changes* to an existing controller count as updates.
       *
       * Skipped in dev mode only — the SW would serve stale bundles
       * between edits.
       */
      /*
       * Offline banner visibility. Purely browser-signal driven —
       * navigator.onLine + online/offline window events. This is a
       * lightweight visual hint; the ACTUAL "should we queue this
       * write?" decision lives in src/lib/connectivity.ts and also
       * consults Firebase's /.info/connected. Banner and connectivity
       * store are allowed to disagree briefly (e.g. WiFi with captive
       * portal: navigator says online, Firebase can't reach) — the
       * banner will be hidden but writes still get queued correctly.
       */
      (() => {
        const banner = document.getElementById('offline-banner');
        if (!banner) return;
        const apply = (online) => {
          banner.hidden = online;
          if (online) delete document.body.dataset.offline;
          else document.body.dataset.offline = 'true';
        };
        // navigator.onLine is the primary signal — cheap, sync, no
        // module dependency. Fires online/offline events on state
        // change. But it can lie (WiFi with captive portal, DNS
        // down) so we also subscribe to the connectivity store,
        // which combines navigator.onLine with Firebase's
        // .info/connected. If the connectivity module loads (it
        // needs the Firebase SDK, which is fetched lazily), we
        // upgrade to the combined signal.
        const check = () => apply(navigator.onLine !== false);
        check();
        window.addEventListener('online', check);
        window.addEventListener('offline', check);
        // Re-check on tab return: some browsers suppress
        // online/offline events for background tabs.
        document.addEventListener('visibilitychange', check);
        window.addEventListener('focus', check);
        // Upgrade to combined signal once the connectivity module
        // finishes lazy-importing. Silent-on-failure — if the
        // module never loads (extreme first-visit-offline), we
        // stay on navigator-only.
        import('../lib/connectivity').then((mod) => {
          if (mod && typeof mod.subscribeConnectivity === 'function') {
            mod.subscribeConnectivity((state) => apply(state.online));
          }
        }).catch(() => { /* silent */ });
      })();

      if ('serviceWorker' in navigator) {
        if (import.meta.env.DEV) {
          navigator.serviceWorker.getRegistrations().then((regs) => {
            regs.forEach((r) => r.unregister());
          });
        } else {
          window.addEventListener('load', () => {
            navigator.serviceWorker
              .register(`${import.meta.env.BASE_URL}sw.js`, { scope: import.meta.env.BASE_URL })
              .catch(() => {});

            const hadControllerAtLoad = !!navigator.serviceWorker.controller;
            navigator.serviceWorker.addEventListener('controllerchange', () => {
              if (!hadControllerAtLoad) return;
              window.dispatchEvent(new CustomEvent('carrom:sw-updated'));
            });
          });
        }
      }
    </script>
  </body>
</html>
